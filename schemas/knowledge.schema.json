{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shmm66/AstroLife-Knowledge-Base/main/schemas/knowledge.schema.json",
  "title": "AstroLife Knowledge Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "revision", "language", "topic", "entity_type", "entity",
    "title", "brief", "expanded", "reflection_question", "evidence_class",
    "source_ids", "source_note", "tags", "license", "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "language": { "enum": ["fa", "en"] },
    "topic": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "entity_type": { "enum": ["planet", "house", "aspect", "transit", "relationship", "method", "research", "sign", "point", "technique"] },
    "entity": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 2 },
    "brief": { "type": "string", "minLength": 20 },
    "expanded": { "type": "string", "minLength": 40 },
    "reflection_question": { "type": "string", "minLength": 5 },
    "evidence_class": {
      "enum": ["astronomical_measurement", "historical_tradition", "symbolic_reflection", "empirical_research", "editorial_method"]
    },
    "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "source_note": { "type": "string", "minLength": 10 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "related_ids": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "license": { "const": "CC-BY-4.0" },
    "status": { "enum": ["candidate", "reviewed", "approved", "retired"] },
    "updated_at": { "type": "string", "format": "date" }
  }
}
